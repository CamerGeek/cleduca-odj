# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# URL publique canonique (sans slash final). Utilisée par les métadonnées SEO,
# le sitemap et les liens d’invitation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (base de données, stockage, authentification)
# ---------------------------------------------------------------------------
# Tant que NEXT_PUBLIC_SUPABASE_URL et NEXT_PUBLIC_SUPABASE_ANON_KEY sont
# vides, l’application fonctionne avec le stockage local .data/content.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Obligatoire en production : les écritures du CMS passent par cette clé,
# uniquement côté serveur. Ne jamais l’exposer au navigateur.
# Sans elle, le site passe en lecture seule (RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Après configuration : appliquer supabase/migrations/0001_initial_schema.sql,
# puis « npm run db:seed » pour injecter les contenus vérifiés.

# ---------------------------------------------------------------------------
# E-mail transactionnel (optionnel)
# ---------------------------------------------------------------------------
# Notification des messages de contact. Si vide, aucune notification n’est en-
# voyée et les messages restent consultables dans l’administration.
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Administration locale (développement uniquement)
# ---------------------------------------------------------------------------
# Compte de secours utilisé quand Supabase n’est pas configuré.
# Ne jamais activer ces identifiants sur un déploiement public.
ADMIN_EMAIL=admin@cleduca.local
ADMIN_PASSWORD=
# Secret de signature des sessions (16 caractères minimum, aléatoire).
AUTH_SECRET=

# Autorise explicitement le stockage local hors développement (déconseillé).
ALLOW_LOCAL_CONTENT=false
